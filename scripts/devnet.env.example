# Copy to repo-root `.env` (gitignored) or export in the shell.
# Never commit keypairs.

CLUSTER=devnet
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
# Optional fallback RPC.
# ANCHOR_PROVIDER_URL_FALLBACK=https://devnet.helius-rpc.com/?api-key=

# Deploy / protocol-admin wallet (must have Devnet SOL).
ANCHOR_WALLET=~/.config/solana/id.json

# Set to the deployed program id (may match localnet id if you reuse the key).
# DEVNET_PROGRAM_ID=74UW993wrDasAMyBQ53PjHpYLK5vMkWbRRWFZ7kCmM3G

# Relayer
RELAYER_BIND=127.0.0.1:8787
# RELAYER_FEE_PAYER=~/.config/solana/id.json
# RELAYER_RPC=https://api.devnet.solana.com

# Live-cluster tests
# DEVNET_ONCHAIN=1
# DEVNET_WRITE=1

# Copy to `.env` in this directory (repo root). Never commit `.env`.
# MetaMask export of the *requester* account (same address you deposited PROVE with).
NETWORK_PRIVATE_KEY=

# Live Succinct wrap (costs $PROVE) — leave commented. Happy-path tests read
# committed bytes in zk-circuit/fixtures/happy/ (no prover).
# When wrapping again: uncomment these three AND build with --features network:
# SP1_USE_NETWORK=1
# SP1_PROVER=network
# SP1_GROTH16=1
# Then: RUST_LOG=info cargo run -p zk-circuit-host --features network --release

# Copy to `.env` in this directory (repo root). Never commit `.env`.
# MetaMask export of the *requester* account (same address you deposited PROVE with).
NETWORK_PRIVATE_KEY=

# Live Succinct wrap (costs $PROVE). You run `cargo run -p zk-circuit-host --release` once.
# Unset or 0 = execute only. Do not put the key in tests.
SP1_USE_NETWORK=0
SP1_PROVER=cpu
SP1_GROTH16=0

# When wrapping live, also set:
# SP1_USE_NETWORK=1
# SP1_PROVER=network
# SP1_GROTH16=1
